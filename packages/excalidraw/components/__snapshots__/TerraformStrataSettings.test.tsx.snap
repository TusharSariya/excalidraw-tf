// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TerraformStrataSettings DOM identity > renders a custom epsilon option carried in from a URL 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div><div role="group" aria-label="Strata packed crossing budget"><span class="TerraformImportModal__controlLabel">Crossing budget (ε) <span>extra crossings the packed scorer may accept for shorter, cleaner edges (W8b ε-constraint; 0 = strict)</span></span><select class="TerraformImportModal__select" aria-label="Packed scoring crossing budget epsilon"><option value="0">0 (strict)</option><option value="1">1</option><option value="2">2</option><option value="0.01">0.01 (custom)</option></select></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders a feasible de-band selection without the hint 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div><div class="TerraformImportModal__dependencyHint" role="status" aria-live="polite"><span aria-hidden="true">ⓘ</span><span>Ignored at this <strong>Band depth</strong> — the account that would absorb these resources is still a full-width band, so each one would land on its own row (one tall stack). Move Band depth shallower, or pick a deeper level to dissolve.</span></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders every toggle in its on state 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced"><summary class="TerraformImportModal__advancedSummary" aria-disabled="false" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="4"></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div><div class="TerraformImportModal__couplingHint"><span aria-hidden="true">ⓘ</span><span>Usually no visible change: nothing yet makes a container taller, so this check rarely has anything to catch. Mainly groundwork for a later pass.</span></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div><div role="group" aria-label="Strata packed crossing budget"><span class="TerraformImportModal__controlLabel">Crossing budget (ε) <span>extra crossings the packed scorer may accept for shorter, cleaner edges (W8b ε-constraint; 0 = strict)</span></span><select class="TerraformImportModal__select" aria-label="Packed scoring crossing budget epsilon"><option value="0">0 (strict)</option><option value="1">1</option><option value="2">2</option></select></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the de-band suppression hint for an infeasible pairing 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="VPC" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="4"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Down to VPCs stay full-width; only subnet zones pack.<span class="TerraformImportModal__depthReadoutCaption">Experimental — usually wider.</span></div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div><div class="TerraformImportModal__dependencyHint" role="status" aria-live="polite"><span aria-hidden="true">ⓘ</span><span>Ignored at this <strong>Band depth</strong> — the region that would absorb these resources is still a full-width band, so each one would land on its own row (one tall stack). Move Band depth shallower, or pick a deeper level to dissolve.</span></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the default panel 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the experimental deep band depth readout 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="VPC" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="4"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Down to VPCs stay full-width; only subnet zones pack.<span class="TerraformImportModal__depthReadoutCaption">Experimental — usually wider.</span></div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the height gate hint when its refereed pass is off 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div><div class="TerraformImportModal__couplingHint"><span aria-hidden="true">ⓘ</span><span>Does nothing on its own — turn on <strong>Compact pure-sink accounts</strong>, the pass it referees.</span></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the height gate hint when its refereed pass is on 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced"><summary class="TerraformImportModal__advancedSummary" aria-disabled="false" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div><div class="TerraformImportModal__couplingHint"><span aria-hidden="true">ⓘ</span><span>Primarily useful with <strong>Compact height</strong> enabled — that pass is what strands whole accounts in the far-right columns for the clamp to pull back.</span></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div><div class="TerraformImportModal__couplingHint"><span aria-hidden="true">ⓘ</span><span>Usually no visible change: nothing yet makes a container taller, so this check rarely has anything to catch. Mainly groundwork for a later pass.</span></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the packed scoring sub-controls and the epsilon dependency hint 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Account" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="2"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Providers and accounts stay full-width bands; regions and below pack.</div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div><div role="group" aria-label="Strata packed crossing budget"><span class="TerraformImportModal__controlLabel">Crossing budget (ε) <span>extra crossings the packed scorer may accept for shorter, cleaner edges (W8b ε-constraint; 0 = strict)</span></span><select class="TerraformImportModal__select" aria-label="Packed scoring crossing budget epsilon"><option value="0">0 (strict)</option><option value="1">1</option><option value="2">2</option></select></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;

exports[`TerraformStrataSettings DOM identity > renders the shallow band depth coupling hint 1`] = `"<div class="TerraformImportModal__layoutSettings"><div class="TerraformImportModal__layoutSettingsHeader"><strong>Strata settings</strong><span>Layout passes for the next-gen compound layout (rcll-v2) — ordering + straighten on by default.</span></div><div class="TerraformImportModal__layoutSettingsBody"><div class="TerraformImportModal__layoutSettingsGrid"><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Content</div><div role="group" aria-label="Strata detail level"><span class="TerraformImportModal__controlLabel">Detail <span>how much of each cluster to draw</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Each resource group is drawn as one representative card (the primary resource, e.g. an ECS service standing in for its task definition, target group, etc.). Click a card to expand the resources inside it. Smaller, faster, and easier to scan — you drill in only where you care.">Compact</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every resource is drawn as its own card up front — nothing hidden. You see the complete picture immediately, but the diagram is much denser and taller and takes longer to lay out. Use it when you need to see everything at once rather than explore.">Full</button></div></div><div role="group" aria-label="Strata resource scope"><span class="TerraformImportModal__controlLabel">Resources <span>which resources appear in the diagram</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Draw only resources connected by a .tfd dataflow edge. Keeps the diagram focused on the actual flow; standalone resources (IAM roles, log groups, …) are omitted. The default, and the shorter canvas — see All resources for what the inventory costs.">Dataflow only</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Also draw the unconnected resources, collected into an 'Unconnected' band per scope so they don't clutter the flow. Primary resources (Lambda, S3, ECS, …) keep their full cluster grouping there — category color, nested satellites, expandable — so the band is an inventory, not a pile of bare boxes. Under Dissolve containers the bands relocate to the surviving ancestor hull and NEST, so you can still see which VPC or region each unconnected resource came from. COSTS SUBSTANTIAL SCENE HEIGHT — MEASURED at Band depth = Root with Transpose on: with Dissolve containers off, 8,692 → 14,465px (+66%); with Dissolve containers = VPCs, 8,013 → 15,106px (+88%). Your dataflow diagram is never moved sideways to make room: X and width are frozen and the canvas may only grow downward, so the flow you were reading keeps its shape — you just scroll further.">All resources</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Readability</div><div role="group" aria-label="Strata layer ordering"><span class="TerraformImportModal__controlLabel">Layer ordering <span>reorder bands to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Bands keep the initial model order — arrows between adjacent layers may cross more than necessary.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.">On</button></div></div><div role="group" aria-label="Strata transpose crossing reduction"><span class="TerraformImportModal__controlLabel">Transpose crossing reduction <span>swap neighbouring boxes within a band to remove leftover crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Layer ordering keeps the order the barycenter sweeps produced, with no adjacent-swap cleanup pass.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After Layer ordering runs, repeatedly swap neighbouring boxes within a band whenever the swap removes a crossing — catching crossings the barycenter sweeps leave behind, and only kept when it strictly improves.">On</button></div></div><div role="group" aria-label="Strata straighten"><span class="TerraformImportModal__controlLabel">Straighten edges <span>nudge containers vertically so edges run straighter</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Containers keep the Y position the placement pass (A0) assigned.">Off</button><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Nudges each container's Y toward the median of the containers it connects to, straightening edges — kept only where it doesn't worsen order, bands, or overlap. Validated default: part of the K=4+A7 arm the W5 battery measured as the first task-metric win over v2.">On</button></div></div><div role="group" aria-label="Strata reduce hull crossings"><span class="TerraformImportModal__controlLabel">Reduce hull crossings <span>sift and relocate containers to cut crossing arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Container hulls keep the order the earlier ordering passes produced. Where two unrelated hulls sit close on the canvas, their dependency arrows may still cross through one another — the layout spends no extra effort pulling them apart.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Two passes work to cut crossings between whole container hulls — which the owner ranks ABOVE shorter edges (hull-crossings ≻ edge-length): a sift widens the sibling orderings the packed scorer will consider, and a relocation pass moves each hull beside the neighbours it actually links to once edges are straightened. Fewer arrows cross unrelated containers, sometimes at the cost of slightly longer edges. Off by default pending its gate battery.">On</button></div></div><details class="TerraformImportModal__advancedDisclosure TerraformImportModal__strataAdvanced TerraformImportModal__strataAdvanced--disabled"><summary class="TerraformImportModal__advancedSummary" aria-disabled="true" aria-label="Advanced crossing weights">Advanced crossing weights</summary><div role="group" aria-label="Strata crossing objective weights" class="TerraformImportModal__strataAdvancedBody"><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Penetration weight <span>how hard to punish arrows tunnelling through boxes</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Penetration weight" title="How heavily the crossing objective counts a dependency arrow that tunnels straight through an unrelated container box. Raise it to punish tunnelling harder; lower it toward 0 to tolerate more. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing weight <span>how hard to punish two arrows crossing</span></span><input min="0" step="1" inputmode="numeric" disabled="" aria-label="Edge-crossing weight" title="How heavily the crossing objective counts two dependency arrows crossing each other. Raise it to prioritise untangling arrow-vs-arrow crossings; lower it toward 0 to focus on box tunnelling instead. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value="1"></label><label class="TerraformImportModal__strataWeight"><span class="TerraformImportModal__controlLabel">Edge-crossing cap (optional) <span>blank inherits the packed-scoring budget (ε)</span></span><input min="0" step="1" inputmode="numeric" disabled="" placeholder="Inherits ε when blank" aria-label="Edge-crossing cap (optional)" title="An optional ceiling on how many extra arrow-vs-arrow crossings a single crossing-reduction move may add before it is rejected. Leave it blank to inherit the packed edge-scoring crossing budget (ε). Set a number to cap it independently. Applies while any crossing-reduction relocation pass — Reduce hull crossings, Pull leaf sinks toward source, or Compact pure-sink accounts — is on." type="number" value=""></label></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced pure-sink packing">Advanced: pure-sink packing</summary><div role="group" aria-label="Strata compact pure-sink accounts"><span class="TerraformImportModal__controlLabel">Compact pure-sink accounts <span>pull a whole dead-end account left toward the resources it depends on</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A whole dead-end account (one that only receives connections, like an org audit/security account) keeps the far-right columns its longest-path rank assigned it, so its inbound arrows stay long and the diagram stays wide.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Pulls an entire dead-end account block left toward its deepest real source, shortening the long cross-account arrows feeding it — but only when doing so doesn't add crossings or make the diagram taller. Provider frame extents are held fixed this phase, so it shortens the arrows without yet reclaiming overall diagram width.">On</button></div></div></details><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced extra crossing-reduction passes">Advanced: extra crossing-reduction passes</summary><div role="group" aria-label="Strata coordinate cascade"><span class="TerraformImportModal__controlLabel">Coordinate cascade <span>escape net-zero ties in the straighten pass to cut more crossings</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The straighten pass stops at the first column arrangement it cannot improve one column at a time. Where two columns are each locally optimal but a joint move would untangle them, that crossing stays.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Extends Straighten edges: when a column reaches a net-zero tie the straighten pass would otherwise stop at, it escapes to its two-sided median and chases the improvement, keeping the move only if it shortens edges on the A7 length proxy. Cuts more crossings than the straighten pass alone. Measured on the flagship preset: crossings 116 → 98 (−15.5%), routed edge length −1.6%, height unchanged. Does nothing unless Straighten edges is on. Off by default (experimental).">On</button></div></div><div role="group" aria-label="Strata chain relocate"><span class="TerraformImportModal__controlLabel">Chain relocate <span>slide a unit with its exclusive downstream chain to shorten edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="A unit and the resources that depend only on it (a lambda, its SSM parameter, its database) each keep the row their own rank assigned, so the arrows chaining them can stay longer than they need to be.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="After edges are straightened, slides a unit together with its exclusive downstream chain — the resources that depend only on it (its SSM parameter, its database) — vertically as one rigid group, shortening the arrows that link them without disturbing anything else. Measured on the flagship preset: routed edge length −4.3%, crossings 116 → 113, height unchanged. Off by default (experimental).">On</button></div></div></details></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Height &amp; packing</div><div role="group" aria-label="Strata compact height"><span class="TerraformImportModal__controlLabel">Compact height <span>separate sibling stacks to shorten the canvas</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Sibling stacks keep the rank the base longest-path pass assigned — one-way-dependent sibling containers stay stacked down the page instead of sharing a row.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Re-ranks one-way-dependent sibling stacks into disjoint column ranges so the packed skyline can place them side-by-side — a measured TRADE (W5): shorter canvas and better crossing angles, at the cost of more crossings on dependency paths (it undoes the K=4+A7 tracing win). Wins over network-simplex rank when both are requested (network-simplex is dropped, surfaced in scene meta).">On</button></div></div><details class="TerraformImportModal__advancedDisclosure"><summary class="TerraformImportModal__advancedSummary" aria-label="Advanced height gate">Advanced: height gate</summary><div role="group" aria-label="Strata keep containers from growing taller"><span class="TerraformImportModal__controlLabel">Keep containers from growing taller <span>check each clamp move against every container it touches, and keep it only if nothing ends up taller</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="The clamp pass stays inside each container's existing rows, so it only makes moves that need no extra vertical room — a container's height cannot change, and the layout is identical to today's.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Checks every clamp move against each container it touches and throws the move away unless every one of them ends up the same height or shorter. Expect no visible change on this diagram — measured, not guaranteed: the moves these passes happen to make here are all height-safe already, so the check has nothing to catch. On other diagrams it can genuinely reject a move that would have made a container taller. It is the referee a later pass needs, the one that will move neighbours aside to make room.">On</button></div></div></details><div role="group" aria-label="Strata band depth"><span class="TerraformImportModal__controlLabel">Band depth <span>deepest level that stays a full-width band — everything below packs X-disjoint siblings into shared rows</span></span><div class="TerraformImportModal__depthSlider"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">banded</span><input class="TerraformImportModal__depthSliderInput" min="0" max="5" step="1" aria-label="Strata band depth" aria-valuetext="Root" title="Choose the deepest role that still lays out as a full-width band — Root, Provider, Account, Region, VPC, or Zone. Every role below the cut packs X-disjoint siblings into shared rows instead of stacking one-per-row. Shallower cuts toward Root pack provider and account, which reclaims vertical height when Compact height (rankSeparate) is on. Region, VPC, and Zone cuts are experimental and usually make the canvas wider. Root is always banded — packing it would collapse the top-level providers side-by-side." type="range" value="0"><span class="TerraformImportModal__depthSliderAxisLabel" aria-hidden="true">packed</span></div><div class="TerraformImportModal__depthSliderTicks" aria-hidden="true"><span class="TerraformImportModal__depthSliderTick TerraformImportModal__depthSliderTick--active">Root</span><span class="TerraformImportModal__depthSliderTick">Provider</span><span class="TerraformImportModal__depthSliderTick">Account</span><span class="TerraformImportModal__depthSliderTick">Region</span><span class="TerraformImportModal__depthSliderTick">VPC</span><span class="TerraformImportModal__depthSliderTick">Zone</span></div><div class="TerraformImportModal__depthReadout" aria-live="polite">Only Root stays banded; providers and below pack into shared rows.</div><div class="TerraformImportModal__couplingHint"><span aria-hidden="true">ⓘ</span><span>Packing provider and account only reclaims height when <strong>Compact height</strong> is on.</span></div></div><div role="group" aria-label="Strata dissolve containers"><span class="TerraformImportModal__controlLabel">Dissolve containers <span>drop this level's boxes and pack its resources straight into the parent</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Every level of the hierarchy — provider, account, region, VPC, subnet zone — is drawn as its own labelled box. You can see exactly which subnet or VPC a resource lives in, at the cost of one nested frame (and its title bar) per level.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the subnet-zone boxes and packs their resources straight into the VPC. Removes a level of nested frame chrome and lets resources from different subnets share a row — at the cost of no longer being able to see which subnet a resource sits in. MEASURED at the Root band depth: 40.5% shorter canvas (8,692 → 5,170), 24% fewer crossings (173 → 132), 13% less edge length, pierce-per-frame slightly better (1.737 → 1.682) — at the cost of a 2.1× slower build (14.3s → 29.4s). Composes with Transpose (132 → 116 crossings). CAVEAT: every one of those numbers was measured at Band depth = Root; at the shipped default (Account) this rung has ZERO measurement. Ignored (with a note in the scene meta) when the VPC that would absorb the resources is still a full-width band — see Band depth.">Zones</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the VPC boxes AND the subnet zones inside them, packing every resource straight into the region. MEASURED at the Root band depth as a genuine TRADE, not a win: it buys 26% fewer crossings (173 → 128), 31% less edge length and a 17% narrower canvas — but the canvas gets TALLER, not shorter (8,692 → 8,937, +2.8%), arrows tunnel through the surviving frames MORE often (pierce-per-frame 1.737 → 1.857, +6.9%), and the build takes 7.5× longer (14.3s → 107.8s, nearly two minutes). Pick this only if you want the narrower, shorter-edged canvas and can pay that height, pierce and build cost. CAVEAT: measured at Band depth = Root only; ZERO measurement at the shipped default (Account).">VPCs</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the region boxes and everything below them (VPCs, subnet zones), packing every resource straight into the account. NOT MEASURED: no A/B arm exists for this rung — the battery covered Zones and VPCs only, so no claim is made here about height, crossings, pierce or build time. Given that the VPCs rung already regresses height and costs 7.5× the build, treat this deeper rung as exploratory. At the shipped default Band depth (Account) it is also SUPPRESSED — the account that would absorb the resources is still a full-width band, so every resource would land on its own row. Move Band depth shallower to make it legal.">Regions</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Dissolves the account boxes and everything below them, packing every resource straight into the provider — the deepest legal rung, and the largest change to the picture. NOT MEASURED: no A/B arm exists for this rung, so no claim is made about height, crossings, pierce or build time. At the shipped default Band depth (Account) it is SUPPRESSED — the provider that would absorb the resources is still a full-width band, so every resource would land on its own row (one tall stack). Move Band depth shallower to make it legal.">Accounts</button></div></div><div role="group" aria-label="Strata packed edge scoring"><span class="TerraformImportModal__controlLabel">Packed edge scoring <span>score region and VPC sibling order on real edge geometry</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" aria-pressed="true" title="Region/VPC sibling order keeps the legacy per-sweep acceptance: a reorder is accepted only when the LOCAL sibling-chord crossing count strictly decreases. Round 9 proved that counter blind to crossings against a sibling container's internal edges, so edge-shortening moves are often rejected.">Off</button><button type="button" class="TerraformImportModal__segmentedButton" aria-pressed="false" title="Every packed ordering candidate (initial + each sweep) is trial-placed on the real skyline and the WHOLE layout is scored: global edge crossings, then edges tunneling through unrelated containers, then total edge length. Fixes the round-9 blind spot (e.g. a regional SQS parked above a VPC it never talks to). Probe lever pending its gate battery.">On</button></div></div></div><div class="TerraformImportModal__settingsSection"><div class="TerraformImportModal__settingsSectionHeader">Edge style &amp; spacing</div><div role="radiogroup" aria-label="Strata edge style"><span class="TerraformImportModal__controlLabel">Style <span>reshape data-flow edges</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="No reshaping — edges are direct lines (default).">Straight</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Draws each data-flow edge as a smooth curve that keeps its direction easy to follow. Edges that would cut through a card stay straight.">Curve</button></div></div><div role="radiogroup" aria-label="Strata column gap"><span class="TerraformImportModal__controlLabel">Column gap <span>widen the gutters between columns for arrows</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard horizontal gap between columns of cards (150 px). Leave this on unless arrows between columns look cramped.">Default 150</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 200 px, giving edge-routing more room to run arrows between columns without crowding the cards.">Wide 200</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Widens the horizontal gap between columns to 250 px — the roomiest setting, for dense diagrams with many arrows crossing between columns.">Extra 250</button></div></div><div role="radiogroup" aria-label="Strata row gap"><span class="TerraformImportModal__controlLabel">Row gap <span>widen the vertical space between stacked cards</span></span><div class="TerraformImportModal__segmentedControl"><button type="button" role="radio" aria-checked="true" tabindex="0" class="TerraformImportModal__segmentedButton TerraformImportModal__segmentedButton--active" title="The standard vertical gap between stacked cards. Leave this on unless arrows running between rows look cramped.">Default</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 25% more vertical space between stacked cards, opening up the horizontal corridors edge routing uses to run arrows between rows.">1.25×</button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="TerraformImportModal__segmentedButton" title="Adds 50% more vertical space between stacked cards — the roomiest setting, for dense diagrams with many arrows routing between rows.">1.5×</button></div></div><div class="TerraformImportModal__edgeDiagnostic TerraformImportModal__edgeDiagnostic--muted">Edge stats appear after import</div></div></div><aside class="TerraformImportModal__layoutHelp" aria-live="polite" aria-label="Option explanation"><strong class="TerraformImportModal__layoutHelpTitle">Layer ordering · On (K=4) — default</strong><p class="TerraformImportModal__layoutHelpBody">Runs 4 barycenter sweeps per hull to reorder bands and cut crossing arrows between adjacent layers, keeping only the best-scoring order found. Validated default: the W5 battery measured K=4 (+A7) as the first Strata arm to beat the v2 view on predicted dependency-tracing cost.</p><div class="TerraformImportModal__layoutHelpDev"><span class="TerraformImportModal__layoutHelpDevLabel">Implements</span><span class="TerraformImportModal__layoutHelpDevText">strataSweeps=4 (A2, K=4, WP-3a): 4 barycenter sweeps per hull; the banded/packed selector scores {initial, sweep 1..4, height-aware greedy seed} and keeps the best (banded: weightedBandsSkippedCost + crossings tiebreak; packed: strict-crossings-decrease chain). Default ON since the W5 default flip.</span><span class="TerraformImportModal__layoutHelpDevRefs">Sugiyama, Tagawa &amp; Toda 1981 (barycenter ordering) · docs/strata-view-w5-repaired-stats-report.md</span></div></aside></div></div>"`;
